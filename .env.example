# Safe example configuration. Copy to .env and replace every example value locally.
# Never commit .env or a real password.
AD_LDAP_ENABLED=true
AD_EMAIL_DOMAIN=example.com
AD_SERVER=ldap://ldap.example.com
AD_PORT=389
AD_USE_SSL=false
AD_BASE_DN=dc=example,dc=com
AD_BIND_DN=cn=example-user,ou=ServiceAccounts,dc=example,dc=com
AD_BIND_PASSWORD=example-password-not-for-production
AD_USER_ID_ATTRIBUTE=sAMAccountName
AD_EMAIL_ATTRIBUTE=mail
AD_NAME_ATTRIBUTE=displayName
AD_COMMON_NAME_ATTRIBUTE=cn
AD_USER_OBJECT_FILTER=(&(objectClass=user)(objectCategory=person))
AD_USER_SEARCH_FILTER=(sAMAccountName={0})
AD_GROUP_SEARCH_FILTER=(&(objectClass=group)(cn={0}))
AD_GROUP_MEMBER_SEARCH_FILTER=(&(objectClass=user)(objectCategory=person)(memberOf={0}))
AD_EXPORT_HOST_PATH=/etc/app/ADchecker/exports
